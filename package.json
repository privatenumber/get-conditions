{
	"name": "get-conditions",
	"version": "0.0.0-semantic-release",
	"description": "Get Node import conditions at runtime",
	"keywords": [
		"get-conditions",
		"node",
		"import",
		"conditions"
	],
	"license": "MIT",
	"repository": "privatenumber/get-conditions",
	"funding": "https://github.com/privatenumber/get-conditions?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"imports": {
		"#get-conditions": {
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
	"scripts": {
		"lint": "lintroll --cache",
		"build": "pkgroll --minify",
		"test": "pnpm build && node tests/index.ts",
		"dev": "node --watch --conditions=development tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"dependencies": {
		"shell-quote": "^1.8.3",
		"type-flag": "^4.0.3"
	},
	"devDependencies": {
		"@types/node": "^25.3.0",
		"@types/shell-quote": "^1.7.5",
		"clean-pkg-json": "^1.3.0",
		"execa": "^9.6.1",
		"fs-fixture": "^2.11.0",
		"lintroll": "^1.29.1",
		"manten": "2.0.0-beta.2",
		"pkgroll": "^2.26.3",
		"typescript": "^5.9.3"
	}
}
