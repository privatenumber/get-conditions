{
	"name": "get-conditions",
	"version": "0.0.0-semantic-release",
	"description": "Get Node import conditions at runtime",
	"keywords": [
		"get-conditions",
		"node",
		"import",
		"conditions"
	],
	"license": "MIT",
	"repository": "privatenumber/get-conditions",
	"funding": "https://github.com/privatenumber/get-conditions?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"imports": {
		"#get-conditions": {
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
	"scripts": {
		"lint": "lintroll --cache",
		"build": "pkgroll --minify",
		"test": "pnpm build && node tests/index.ts",
		"dev": "node --watch --conditions=development tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"devDependencies": {
		"@types/node": "^25.3.5",
		"clean-pkg-json": "^1.3.0",
		"fs-fixture": "^2.11.0",
		"get-node": "^15.0.4",
		"get-option-value": "^1.0.0",
		"lintroll": "^1.29.1",
		"manten": "2.0.0",
		"nano-spawn": "^2.0.0",
		"pkgroll": "^2.26.3",
		"typescript": "^5.9.3"
	}
}
